# Parichay Environment Configuration
# Duplicate this file as .env and populate your personal secrets if desired

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1
SECRET_KEY=parichay-career-intelligence-secret-key-production

# External AI API (Optional - Parichay includes a deterministic grounded fallback if unset)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
